{
  "host": "127.0.0.1",
  "port": 8787,
  "mediaRoot": "./media",
  "corsOrigin": "*",
  "defaultCodec": "h265",
  "segmentDurationSec": 15,
  "prerollSec": 15,
  "ringSegmentSec": 6,
  "ringWrap": 15,
  "bitratesKbps": {
    "LONG": 6000,
    "WIDE": 3000,
    "IR": 2000
  },
  "channels": {
    "LONG": {
      "url": "http://panoptes-base.local/2k-stream",
      "fallback": "http://panoptes.local/2k-stream",
      "kind": "mjpeg",
      "comment": "Same MJPEG the HMI shows. Override with env STREAM_LONG."
    },
    "WIDE": {
      "url": "",
      "kind": "none",
      "comment": "Not fitted on this turret — do not record a lab pattern."
    },
    "IR": {
      "url": "http://panoptes.local/thermal/stream",
      "kind": "mjpeg"
    }
  },
  "ffmpegPath": "ffmpeg",
  "preferHw": false,
  "hwEncoder": "hevc_nvenc"
}
